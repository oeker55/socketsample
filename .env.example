PORT=3000

# Keep "all" in production so direct P2P/STUN stays free when possible.
# Use "relay" only for temporary TURN testing.
ICE_TRANSPORT_POLICY=all

# self = own coturn, metered = Metered.ca only, both = both providers, none = STUN only
TURN_PROVIDER=self

# Own coturn server
TURN_URLS=turn:80.225.238.243:3478?transport=udp,turn:80.225.238.243:3478?transport=tcp
TURN_USERNAME=royalstream
TURN_CREDENTIAL=change-me-strong-password

# Optional paid TURN provider. Set TURN_PROVIDER=metered to test only Metered.ca.
METERED_API_KEY=
METERED_DOMAIN=
