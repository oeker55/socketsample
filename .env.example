PORT=3000

# Keep "all" in production so direct P2P/STUN stays free when possible.
# Use "relay" only for temporary TURN testing.
ICE_TRANSPORT_POLICY=all

# Own coturn server
TURN_URLS=turn:TURN_DOMAIN_OR_IP:3478?transport=udp,turn:TURN_DOMAIN_OR_IP:3478?transport=tcp
TURN_USERNAME=change-me
TURN_CREDENTIAL=change-me-strong-password

# Optional paid TURN provider. Leave empty when using your own TURN.
METERED_API_KEY=
METERED_DOMAIN=
