{
  "name": "canli-yayin",
  "version": "1.0.0",
  "description": "WebRTC tabanlı canlı yayın paylaşım uygulaması",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "agent": "node local-agent.js",
    "build-agent": "npx @yao-pkg/pkg@6.2.0 local-agent.js --targets node18-win-x64 --output public/agent.exe --compress GZip",
    "build-agent-mac": "npx @yao-pkg/pkg@6.2.0 local-agent.js --targets node18-macos-x64 --output public/agent-mac --compress GZip",
    "build-agent-all": "npm run build-agent && npm run build-agent-mac"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
