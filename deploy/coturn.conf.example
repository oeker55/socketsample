# coturn example for Royal Stream / canli-yayin
#
# Replace the PUBLIC_IP, PRIVATE_IP, DOMAIN, USERNAME and STRONG_PASSWORD
# placeholders before copying this file to /etc/turnserver.conf.

listening-port=3478
tls-listening-port=5349
listening-ip=0.0.0.0

# On cloud providers with 1:1 NAT, use PUBLIC_IP/PRIVATE_IP.
# If the server has the public IP directly, PUBLIC_IP alone is enough.
external-ip=PUBLIC_IP/PRIVATE_IP

realm=DOMAIN
server-name=DOMAIN
fingerprint
lt-cred-mech
user=USERNAME:STRONG_PASSWORD

total-quota=200
bps-capacity=0
stale-nonce=600

no-multicast-peers
no-loopback-peers
no-cli
simple-log
log-file=/var/log/turnserver/turn.log

# Enable these after certificates exist.
# cert=/etc/letsencrypt/live/DOMAIN/fullchain.pem
# pkey=/etc/letsencrypt/live/DOMAIN/privkey.pem
